# ── Application ───────────────────────────────────────────────────────────
APP_NAME="Bookmarks API"
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────
# Default: local SQLite (zero setup).
DATABASE_URL=sqlite:///./bookmarks.db
# PostgreSQL (used by the Podman stack):
# DATABASE_URL=postgresql+psycopg://bookmarks:bookmarks@db:5432/bookmarks

# ── JWT ───────────────────────────────────────────────────────────────────
# Local-dev default below is fine because ENVIRONMENT=development.
# Outside development the app REFUSES to start with a weak/known/short secret.
# Generate a strong one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me-to-a-long-random-string-please
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# ── Rate limiting (bonus) ─────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=15/minute
