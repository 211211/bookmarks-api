# ── Application ───────────────────────────────────────────────────────────
APP_NAME="Bookmarks API"
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────
# Default: local SQLite (zero setup).
DATABASE_URL=sqlite:///./bookmarks.db
# PostgreSQL (used by the Podman stack):
# DATABASE_URL=postgresql+psycopg://bookmarks:bookmarks@db:5432/bookmarks

# ── JWT ───────────────────────────────────────────────────────────────────
# Local-dev default below is fine because ENVIRONMENT=development.
# Outside development the app REFUSES to start with a weak/known/short secret.
# Generate a strong one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me-to-a-long-random-string-please
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# ── Rate limiting (bonus) ─────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=15/minute
# Optional shared store for correct limits across workers (e.g. redis://host:6379).
# RATE_LIMIT_STORAGE_URI=
# Only enable behind a reverse proxy you trust to set X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# ── Login abuse protection ────────────────────────────────────────────────
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_SECONDS=300

# ── HTTP hardening ────────────────────────────────────────────────────────
# Comma-separated allow-lists; "*" = any (fine for local dev only).
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
TRUSTED_HOSTS=*
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false          # enable only when served over HTTPS
MAX_REQUEST_BYTES=1048576   # 1 MiB
DOCS_ENABLED=true           # set false to hide /docs in production

# ── Database connection pool (ignored on SQLite) ──────────────────────────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT=30
